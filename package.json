{
  "name": "central-go",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "generate:locations": "node scripts/generate-world-location-data.mjs",
    "generate:partner-pdf": "python3 scripts/generate-partner-requirements.py",
    "check:commercial": "node scripts/commercial-check.mjs",
    "test": "npm run lint && npm run check:commercial && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "world-cities-json": "1.0.1"
  },
  "description": "Central GO 2.0 - despacho SaaS con onboarding para centrales, conductores y socios comerciales.",
