{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__supabase/:path*",
      "destination": "https://cuazdzsvgwrnpczbvrgx.supabase.co/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Cross-Origin-Opener-Policy","value":"same-origin"},
        {"key":"Permissions-Policy","value":"geolocation=(self), camera=(self), microphone=()"},
        {"key":"X-Robots-Tag","value":"noindex, nofollow"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://cuazdzsvgwrnpczbvrgx.supabase.co wss://cuazdzsvgwrnpczbvrgx.supabase.co https://router.project-osrm.org; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/data/world-locations/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=86400, stale-while-revalidate=604800"}
      ]
    },
    {
      "source": "/",
      "headers": [
        {"key":"Cache-Control","value":"no-store, max-age=0"}
      ]
    },
    {
      "source": "/driver",
      "headers": [
        {"key":"Cache-Control","value":"no-store, max-age=0"}
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {"key":"Cache-Control","value":"no-store, max-age=0"}
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"},
        {"key":"Service-Worker-Allowed","value":"/"}
      ]
    }
  ]
}
